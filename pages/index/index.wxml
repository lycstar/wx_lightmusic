<import src="../../common/item/item.wxml" />
<!-- 坑，设置view背景真机不会显示，采用image全屏 -->
<!-- <view style="background-image: url('../../image/bg.jpg');background-repeat: no-repeat;background-attachment: fixed;"> -->
<view>
  <image class='bg' mode='aspectFill' src="{{currentMusic.coverImgUrl}}" />

  <swiper style="height: {{swiperHeight}}px;">
    <swiper-item class="middle-l">
      <view class='search_box' style="padding-top:60px;">
        <view class='search_left_right'>
          <image src='../../image/ic_music.png' class='search_image' />
        </view>
        <input class="search_input" placeholder-class="placeholderStyle" placeholder="Everything is ok..." bindinput='getKeyWord' />
        <view class='search_left_right'>
          <image src='../../image/ic_music_search.png' class="search_image" bindtap='clickSearch' />
        </view>
      </view>
      <scroll-view scroll-y bindscrolltolower="searchMusic" style="height: {{searchScrollHeight}}px;padding-top:120px;">
        <block class="item" wx:key="dataId" wx:for-items="{{dataList}}">
          <view bindtap="getMusic" data-music="{{item}}">
            <template is="searchItem" data="{{title:item.name,singer_album:item.singer[0].name+' | '+item.album.title,image_src:'https://y.gtimg.cn/music/photo_new/T002R300x300M000'+item.album.mid+ '.jpg?max_age=2592000'}}"></template>
          </view>
        </block>
      </scroll-view>
    </swiper-item>
    <swiper-item class="middle-r">
      <scroll-view class="lyric-wrapper" style="height: {{lyricScrollHeight}}px;padding-top:60px;" scroll-y scroll-into-view="line{{toLineNum}}" scroll-with-animation>
        <view v-if="currentLyric">
          <view ref="lyricLine" id="line{{index}}" class="text {{currentLineNum == index ? 'current': '' }}" wx:for="{{currentLyric.lines}}">{{item.txt}}
          </view>
        </view>
        <view wx:if="{{!currentLyric}}">
          <view class="text current">暂无歌词</view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <view class="controler_music">
    <view class="controler_music_bottom">
      <view class="controler_music_image">
        <image class='controler_img' src='{{currentMusic.coverImgUrl}}' />
      </view>
      <view class="controler_music_info">
        <view class="controler_music_title">{{currentMusic.title}}</view>
        <view class="controler_music_singer">{{currentMusic.singer}}</view>
      </view>
      <view class="controler_music_status" bindtap='musicControler'>
        <!-- <image class='controler_img' src="../../image/ic_{{playing==-1?'play.png':playing==1?'pause.png':'play.png'}}" /> -->
        <image class='controler_status_img' src="../../image/ic_{{playing==1?'pause.png':'play.png'}}" />
      </view>
    </view>
  </view>
</view>